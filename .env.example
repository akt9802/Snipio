# ── Local development ────────────────────────────────────────────────────────
# Leave SOCKET URL empty so the browser talks to <hostname>:3001
NEXT_PUBLIC_SOCKET_URL=
SOCKET_PORT=3001
# Optional. Local QR uses your LAN IP automatically; set this to force it.
# NEXT_PUBLIC_APP_ORIGIN=http://192.168.1.10:3000
NEXT_PUBLIC_APP_ORIGIN=

# ── Production (VM) ──────────────────────────────────────────────────────────
# Copy this file to .env on the server and fill these in before docker build.
# NEXT_PUBLIC_* values are baked into the client bundle at BUILD time.
#
# PORT=3002
# SOCKET_PORT=3003
# NODE_ENV=production
# NEXT_PUBLIC_SOCKET_URL=https://snipio.akt9802.in
# NEXT_PUBLIC_APP_ORIGIN=https://snipio.akt9802.in
